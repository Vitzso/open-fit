# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./openfit.db"

# Where the Next.js server reaches Ollama. The iPhone never talks to Ollama
# directly — requests are proxied through /api/coach — so if Ollama runs on the
# same PC, 127.0.0.1 is fine. Use the other machine's address (http://<its-ip>:11434)
# only if Ollama runs elsewhere. Model and URL can also be changed in Settings → AI coach connection.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:latest"
# Any chat model from https://ollama.com/library works (gemma4:latest, llama3.1:8b, qwen3:8b, …).
# For "thinking" models (gemma4, qwen3, deepseek-r1): none = answer immediately (default);
# low / medium / high = reason silently first (better on tricky questions, slower).
# "low" is a good choice on a fast GPU: a 3–5 s pause for noticeably better coaching.
OLLAMA_REASONING_EFFORT="none"

# ── Security ──
# Passcode required on every device (strongly recommended: without it anyone on
# your Wi-Fi can read and change your data). Each device signs in once.
APP_PASSCODE=""
# Extra names or addresses this PC is reached by, comma-separated (e.g. "my-pc.lan").
# Not needed for its own IPs, localhost, *.local or Tailscale names, which always work.
# Other hostnames are rejected to block DNS-rebinding attacks. Also added to the HTTPS certificate.
ALLOWED_HOSTS=""

# Open Food Facts asks API clients to identify themselves.
OFF_USER_AGENT="OpenFit/0.1 (self-hosted personal tracker)"
