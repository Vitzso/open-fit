// OpenFit — SQLite schema.
// Conventions:
//   * `day` columns are local calendar dates as "YYYY-MM-DD" strings, which keeps
//     "what did I eat today" queries free of timezone arithmetic.
//   * All weights are stored in kilograms; the UI converts to lb when the user
//     picks that unit in Settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Single-row table (id = 1) with goals and integration settings.
model Settings {
  id                Int      @id @default(1)
  weightUnit        String   @default("kg") // "kg" | "lb"; also switches height to inches when "lb"
  weekStart         Int      @default(0) // first day of the week: 0 = Sunday … 6 = Saturday
  calorieGoal       Int      @default(2000)
  proteinGoal       Int      @default(150)
  carbsGoal         Int      @default(200)
  fatGoal           Int      @default(65)
  goalWeightKg      Float?
  // Body profile, used to estimate calorie needs (all optional).
  sex               String? // "male" | "female"
  birthYear         Int?
  heightCm          Float?
  activityLevel     String? // "sedentary" | "light" | "moderate" | "very"
  weeklyLossPct     Float    @default(0.6) // target fat-loss pace, % of body weight per week
  ollamaBaseUrl     String? // overrides OLLAMA_BASE_URL when set
  ollamaModel       String? // overrides OLLAMA_MODEL when set
  ollamaReasoning   String? // "none" | "low" | "medium" | "high"; overrides OLLAMA_REASONING_EFFORT when set
  coachInstructions String? // the user's own standing instructions for the AI coach
  enabledModules    String   @default("") // optional modules switched on in Settings, comma-separated ids (src/lib/modules)
  updatedAt         DateTime @updatedAt
}

// ───────────── Workouts (openGym module) ─────────────

model Exercise {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  muscleGroup String?
  createdAt   DateTime     @default(now())
  sets        WorkoutSet[]
}

model Workout {
  id         Int          @id @default(autoincrement())
  day        String
  name       String?
  notes      String?
  templateId String? // id from src/lib/programs.ts when started from a ready-made workout
  startedAt  DateTime     @default(now())
  sets       WorkoutSet[]

  @@index([day])
}

model WorkoutSet {
  id         Int      @id @default(autoincrement())
  workoutId  Int
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  reps       Int
  weightKg   Float    @default(0)
  rpe        Float?
  notes      String?
  kind       String   @default("work") // "warmup" | "work" | "drop" (Pro training module); warm-ups don't count for records
  /// Id made on the phone when the set was logged, so a sync retry can't save it twice.
  clientId   String?  @unique
  createdAt  DateTime @default(now())

  @@index([workoutId])
  @@index([exerciseId])
}

model BodyWeight {
  id        Int      @id @default(autoincrement())
  day       String   @unique
  weightKg  Float
  createdAt DateTime @default(now())
}

// ───────────── Nutrition (OpenNutriTracker module) ─────────────

/// Cache of Open Food Facts lookups so re-scanning a product is instant/offline.
model FoodProduct {
  barcode           String   @id
  name              String
  brand             String?
  imageUrl          String?
  servingSize       String?
  servingQuantityG  Float?
  kcal100g          Float
  protein100g       Float
  carbs100g         Float
  fat100g           Float
  nutritionComplete Boolean  @default(true)
  fetchedAt         DateTime @default(now())
}

model FoodEntry {
  id        Int      @id @default(autoincrement())
  day       String
  meal      String   @default("snack") // breakfast | lunch | dinner | snack
  name      String
  brand     String?
  barcode   String?
  grams     Float?
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  /// Id made on the phone when the entry was logged, so a sync retry can't save it twice.
  clientId  String?  @unique
  createdAt DateTime @default(now())

  @@index([day])
}

// ───────────── AI coach ─────────────

/// The coach's short note for a day, generated once and shown on Today.
model CoachNote {
  id        Int      @id @default(autoincrement())
  day       String   @unique
  content   String
  createdAt DateTime @default(now())
}

/// Progress reports written for the desktop dashboard, newest last. Kept so the
/// dashboard opens instantly with the latest one and you can compare over time.
model CoachReport {
  id        Int      @id @default(autoincrement())
  rangeDays Int // how many days of data the report looked at
  content   String
  createdAt DateTime @default(now())
}

model CoachMessage {
  id        Int      @id @default(autoincrement())
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

// ───────────── Pro training module (src/modules/training-pro) ─────────────

/// A workout plan you built yourself (shown next to the ready-made ones while the module is on).
model UserProgram {
  id        Int                   @id @default(autoincrement())
  name      String
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  exercises UserProgramExercise[]
}

model UserProgramExercise {
  id        Int         @id @default(autoincrement())
  programId Int
  program   UserProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  sets      Int
  reps      String // "8", "8-10", "30 s"
  restSec   Int
  supersetWithNext Boolean @default(false) // done back to back with the next exercise, resting after the round

  @@index([programId])
}

// ───────────── Imports and Apple Health ─────────────

/// A token for a device that sends data without the passcode cookie (an iPhone Shortcut).
/// Only a SHA-256 hash is stored; the token itself is shown once when it's made.
model ApiToken {
  id         Int       @id @default(autoincrement())
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

/// Daily activity from Apple Health (via the Shortcut): steps and active energy.
model DailyActivity {
  id         Int      @id @default(autoincrement())
  day        String   @unique
  steps      Int?
  activeKcal Float?
  updatedAt  DateTime @updatedAt
}
