{
  "name": "openfit-desktop",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "description": "OpenFit progress dashboard for Windows and macOS: charts and AI coach reports from your local OpenFit database.",
  "author": "OpenFit contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle.mjs",
    "dist:win": "node scripts/bundle.mjs && electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.openfit.desktop",
    "productName": "OpenFit",
    "files": [
      "main.js",
      "server.js",
      "install.js",
      "loading.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "bundle/openfit",
          "to": "openfit"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "OpenFit Dashboard",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.healthcare-fitness",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
